# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local security boundary. The server binds to loopback by default.
# Set JARVIS_API_TOKEN before using a non-loopback JARVIS_HOST.
JARVIS_HOST="127.0.0.1"
JARVIS_API_TOKEN=""
# Use the platform path separator (':' on Linux, ';' on Windows).
JARVIS_AUTHORIZED_ROOTS=""
JARVIS_AGENT_YOLO=false

# Central Brain has its own loopback listener and restricted CORS allowlist.
CENTRAL_BRAIN_HOST="127.0.0.1"
CENTRAL_BRAIN_PORT=8200
CENTRAL_BRAIN_CORS_ORIGINS="http://127.0.0.1:8200,http://localhost:8200,http://127.0.0.1:3000,http://localhost:3000"

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# GitHub MCP OAuth Configuration
# Setup at https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: http://localhost:3000/api/connectors/callback
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# Firebase Client Configuration (Optional, for Google Auth / Workspace Connectors)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_MEASUREMENT_ID=""

# NVIDIA OpenShell Security & Sandbox Configuration
OPENSHELL_ENABLED=true
OPENSHELL_MODE=hybrid                 # strict | hybrid | disabled
OPENSHELL_GATEWAY_PORT=17670
OPENSHELL_SANDBOX_TIMEOUT=30000
OPENSHELL_POLICY_PATH=backend/system_modules/intelligent_system/openshell_policy.json
